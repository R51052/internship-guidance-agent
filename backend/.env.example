# Copy to backend/.env. Use real values only in the untracked local file.
DEMO_MODE=true
SEED_DEMO_DATA=true
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5500
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60

MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DATABASE=internship_guidance

# auto selects a configured provider; mock is used only when no provider key exists.
LLM_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
